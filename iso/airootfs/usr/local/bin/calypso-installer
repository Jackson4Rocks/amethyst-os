#!/bin/bash
set -euo pipefail

# Calypso Linux — Plasma + Aurora Dotfiles installer
# WARNING: the selected disk is erased completely.

if [ "$EUID" -ne 0 ]; then exec sudo "$0" "$@"; fi

RED='$\033[1;31m'
GREEN='$\033[1;32m'
YELLOW='$\033[1;33m'
CYAN='$\033[1;36m'
RESET='$\033[0m'

die() { printf '\n$bERROR:$b %s\n' "$RED" "$RESET" "$*"; exit 1; }
cleanup() { sync || true; umount -R /mnt 2>/dev/null || true; swapoff -a 2>/dev/null || true; }
trap cleanup EXIT
need() { command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"; }

clear
printf '%s\n' '============================================================'
printf '$b%s$b\n' "$CYAN" 'CALYPSO LINUX' "$RESET"
printf '%s\n' '             PLASMA + AURORA DOTFILES'
printf '%s\n' '                 GUIDED INSTALLER'
printf '%s\n' '============================================================'
printf '\n'
printf 'Calypso Linux is an Arch-based desktop system.\n'
printf 'Profiles: KDE Plasma (default) and Hyprland + Aurora Dotfiles.\n\n'
printf '$bWARNING:$b Whole-disk installation only.\n' "$RED" "$RESET"
printf '$bWARNING:$b The selected disk will be erased completely.\n' "$RED" "$RESET"
printf 'There is no automatic dual-boot partitioning in this installer.\n\n'

[ -d /sys/firmware/efi ] || die 'Boot the ISO in UEFI mode.'
for c in lsblk wipefs parted partprobe udevadm mkfs.fat mkfs.ext4 mount umount pacstrap genfstab arch-chroot bootctl blkid readlink; do need "$c"; done

printf 'Checking network...\n'
if ! getent hosts archlinux.org >/dev/null 2>&1; then
    printf '$bNetwork is not ready. $bUse nmtui or nmcli, then return here.\n' "$YELLOW" "$RESET"
    read -r -p 'Press Enter when connected... ' _
    getent hosts archlinux.org >/dev/null 2>&1 || die 'Network is unavailable.'
fi
printf '$bNetwork: OK$b\n\n' "$GREEN" "$RESET"

printf '$bAVAILABLE DISKS$b\n' "$CYAN" "$RESET"
lsblk -dpno NAME,SIZE,MODEL,TRAN,TYPE | awk '$5=="disk"{print}'
printf '\n'

while true; do
    read -r -p 'Target disk (/dev/vda, /dev/nvme0n1, etc.): ' DISK
    DISK="$(printf '%s' "$DISK" | xargs)"
    [ -n "$DISK" ] || { printf 'Enter a disk path.\n'; continue; }
    [ -b "$DISK" ] || { printf 'Not a block device: %s\n' "$DISK"; continue; }

    DISK="$(readlink -f -- "$DISK")"
    TYPE="$(lsblk -dnro TYPE -- "$DISK" 2>/dev/null || true)"
    [ "$TYPE" = disk ] || { printf '$s is not a whole disk. Do not use a partition.\n' "$DISK"; continue; }

    if lsblk -nrpo MOUNTPOINTS -- "$DISK" | grep -q '[^[:space:]]'; then
        printf '$s has mounted filesystems. Unmount it first.\n' "$DISK"
        continue
    fi
    break
done

printf '\n'
lsblk "$DISK"
printf '\n$bFINAL DISK CHECK$b\n' "$CYAN" "$RESET"
printf 'Target: $s\n' "$DISK"
printf 'Everything on this disk will be destroyed.\n'
printf 'Type $bERASE$b to continue: ' "$RED" "$RESET"
read -r CONFIRM
[ "$CONFIRM" = ERASE ] || die 'Confirmation did not match. Nothing was changed.'

read -r -p 'Username [calypso]: ' USERNAME
USERNAME="${USERNAME:-calypso}"
[[ "$USERNAME" =~ ^[a-z_][a-z0-9_-]*$ ]] || die "Invalid username: $USERNAME"

read -r -p 'Hostname [calypso-pc]: ' HOSTNAME
HOSTNAME="${HOSTNAME:-calypso-pc}"
[[ "$HOSTNAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] || die "Invalid hostname: $HOSTNAME"

read -r -p 'Timezone [Asia/Kolkata]: ' TIMEZONE
TIMEZONE="${TIMEZONE:-Asia/Kolkata}"
[ -f "/usr/share/zoneinfo/$TIMEZONE" ] || die "Unknown timezone: $TIMEZONE"

printf '\n$bDESKTOP PROFILE$b\n' "$CYAN" "$RESET"
printf '  1) KDE Plasma       — Calypso Desktop [default]\n'
printf '  2) Hyprland         — Aurora Dotfiles\n\n'

while true; do
    read -r -p 'Select [1-2] (Enter = 1): ' CHOICE
    CHOICE="${CHOICE:-1}"
    case "$CHOICE" in
        1)
            DESKTOP_ID=kde
            DESKTOP_NAME='KDE Plasma'
            SESSION=plasma.desktop
            DESKTOP_PACKAGES=(plasma-meta konsole dolphin ark xdg-desktop-portal-kde xdg-desktop-portal-gtk)
            break ;;
        2)
            DESKTOP_ID=hyprland
            DESKTOP_NAME=Hyprland
            SESSION=hyprland.desktop
            DESKTOP_PACKAGES=(hyprland quickshell hyprpaper matugen fuzzel yazi jq xdg-desktop-portal-hyprland polkit-gnome)
            break ;;
        *) printf 'Choose 1 or 2.\n' ;;
    esac
done

printf '\nSelected: $b%s$b\n' "$GREEN" "$DESKTOP_NAME" "$RESET"
[ "$DESKTOP_ID" = kde ] && printf 'Branding: Calypso KDE wallpaper enabled.\n' || printf 'Branding: Aurora Dotfiles enabled.\n'

case "$DISK" in
    *[0-9]) PREFIX="${DISK}p" ;;
    *) PREFIX="$DISK" ;;
esac
EFI="${PREFIX}1"
ROOT="${PREFIX}2"

while read -r part; do
    [ -n "$part" ] && umount -R "$part" 2>/dev/null || true
done < <(lsblk -nrpo NAME -- "$DISK")
swapoff -a 2>/dev/null || true

printf '\nCreating GPT layout...\n'
wipefs -af -- "$DISK"
parted -s -- "$DISK" mklabel gpt \
    mkpart ESP fat32 1MiB 1025MiB \
    set 1 esp on \
    mkpart ROOT ext4 1025MiB 100%
partprobe -- "$DISK" 2>/dev/null || true
udevadm settle
sleep 2

[ -b "$EFI" ] || die "Missing EFI partition: $EFI"
[ -b "$ROOT" ] || die "Missing root partition: $ROOT"

mkfs.fat -F32 -n CALYPSO-ESP "$EFI"
mkfs.ext4 -F -L CALYPSO "$ROOT"
mount "$ROOT" /mnt
mkdir -p /mnt/boot
mount "$EFI" /mnt/boot

BASE=(base base-devel linux linux-firmware sudo zsh git networkmanager systemd-resolvconf sddm kitty fastfetch pipewire pipewire-pulse wireplumber xdg-desktop-portal xdg-desktop-portal-gtk xorg-xwayland mesa polkit brightnessctl playerctl grim slurp wl-clipboard power-profiles-daemon noto-fonts)
printf '\nInstalling Calypso Linux + $s...\n' "$DESKTOP_NAME"
pacstrap -K /mnt "${BASE[@]}" "${DESKTOP_PACKAGES[@]}"

CPU="$(lscpu | awk -F: '/Vendor ID/{gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit}')"
case "$CPU" in
    GenuineIntel) pacstrap -K /mnt intel-ucode ;;
    AuthenticAMD) pacstrap -K /mnt amd-ucode ;;
esac

genfstab -U /mnt > /mnt/etc/fstab
ROOT_UUID="$(blkid -s UUID -o value "$ROOT")"
[ -n "$ROOT_UUID" ] || die 'Could not determine root UUID.'

arch-chroot /mnt /bin/bash -s -- "$TIMEZONE" "$HOSTNAME" "$USERNAME" "$ROOT_UUID" "$DESKTOP_ID" "$DESKTOP_NAME" "$SESSION" <<'CHROOT'
set -euo pipefail
TZ="$1"; HOST="$2"; USERNAME="$3"; UUID="$4"; DESKTOP="$5"; SESSION="$7"

ln -sf "/usr/share/zoneinfo/$TZ" /etc/localtime
hwclock --systohc
printf 'en_US.UTF-8 UTF-8\n' > /etc/locale.gen
locale-gen
printf 'LANG=en_US.UTF-8\n' > /etc/locale.conf
printf '%s\n' "$HOST" > /etc/hostname

cat > /etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $HOST.localdomain $HOST
EOF

mkinitcpio -P
bootctl --esp-path=/boot install
mkdir -p /boot/loader/entries
printf '%s\n' 'default calypso.conf' 'timeout 3' 'console-mode auto' 'editor no' > /boot/loader/loader.conf

cat > /boot/loader/entries/calypso.conf <<EOF
title   Calypso Linux
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=UUID=$UUID rw
EOF

[ -f /boot/intel-ucode.img ] && sed -i '/initrd  \/initramfs-linux.img/i initrd  /intel-ucode.img' /boot/loader/entries/calypso.conf
[ -f /boot/amd-ucode.img ] && sed -i '/initrd  \/initramfs-linux.img/i initrd  /amd-ucode.img' /boot/loader/entries/calypso.conf

systemctl enable NetworkManager.service
systemctl enable systemd-resolved.service
systemctl enable sddm.service
systemctl enable power-profiles-daemon.service

mkdir -p /etc/NetworkManager/conf.d
printf '%s\n' '[main]' 'dns=systemd-resolved' > /etc/NetworkManager/conf.d/10-dns.conf
rm -f /etc/resolv.conf
ln -s /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf

cat > /usr/lib/os-release <<'EOF'
NAME="Calypso Linux"
ID=calypso
ID_LIKE=arch
PRETTY_NAME="Calypso Linux"
VERSION="0.2"
VERSION_ID="0.2"
HOME_URL="https://github.com/Jackson4Rocks/calypso-linux"
SUPPORT_URL="https://github.com/Jackson4Rocks/calypso-linux/issues"
BUG_REPORT_URL="https://github.com/Jackson4Rocks/calypso-linux/issues"
EOF
rm -f /etc/os-release
ln -s ../usr/lib/os-release /etc/os-release

install -d -m 0755 /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/calypso-wheel
chmod 0440 /etc/sudoers.d/calypso-wheel

useradd -m -G wheel -s /usr/bin/zsh "$USERNAME"
install -d -m 0755 "/home/$USERNAME/.config" "/home/$USERNAME/.config/autostart" "/home/$USERNAME/.local/share"

cp -a /etc/skel/.zshrc "/home/$USERNAME/.zshrc"
cp -a /etc/skel/.config/fastfetch "/home/$USERNAME/.config/"
cp -a /etc/skel/.config/kitty "/home/$USERNAME/.config/"
cp -a /etc/skel/.local/share/calypso "/home/$USERNAME/.local/share/"

cat > /etc/sddm.conf.d/calypso.conf <<EOF
[General]
DisplayServer=wayland
[Autologin]
User=$USERNAME
Session=$SESSION
Relogin=false
EOF

if [ "$DESKTOP" = kde ]; then
    cp -a /etc/skel/.config/autostart/calypso-plasma-wallpaper.desktop "/home/$USERNAME/.config/autostart/"
fi

if [ "$DESKTOP" = hyprland ]; then
    cp -a /etc/skel/.config/hypr "/home/$USERNAME/.config/"
    cp -a /etc/skel/.config/quickshell "/home/$USERNAME/.config/"
    cp -a /etc/skel/.config/matugen "/home/$USERNAME/.config/"
    cp -a /etc/skel/.config/fuzzel "/home/$USERNAME/.config/"
    cp -a /etc/skel/.local/bin/calypso-wallpaper "/home/$USERNAME/.local/bin/"
fi

cat > "/home/$USERNAME/.profile" <<EOF
export CALYPSO_NAME="Calypso Linux"
export CALYPSO_DOTFILES="Aurora Dotfiles"
export CALYPSO_DESKTOP="$DESKTOP"
export QT_QPA_PLATFORM=wayland
export GDK_BACKEND=wayland,x11
export SDL_VIDEODRIVER=wayland
export MOZ_ENABLE_WAYLAND=1
EOF
printf '%s\n' 'export CALYPSO_NAME="Calypso Linux"' 'export CALYPSO_DOTFILES="Aurora Dotfiles"' > "/home/$USERNAME/.zshenv"

if [ -f "/home/$USERNAME/.local/share/calypso/calypso-mark.svg" ]; then
    install -d -m 0755 /usr/share/icons/hicolor/scalable/apps
    install -m 0644 "/home/$USERNAME/.local/share/calypso/calypso-mark.svg" /usr/share/icons/hicolor/scalable/apps/calypso-linux.svg
fi
if [ -f "/home/$USERNAME/.local/share/calypso/wallpapers/Calypso-Default.svg" ]; then
    install -d -m 0755 /usr/share/backgrounds/calypso
    install -m 0644 "/home/$USERNAME/.local/share/calypso/wallpapers/Calypso-Default.svg" /usr/share/backgrounds/calypso/Calypso-Default.svg
fi

rm -f "/home/$USERNAME/.config/systemd/user/calypso-live-welcome.service"
rm -f "/home/$USERNAME/.config/systemd/user/default.target.wants/calypso-live-welcome.service"
rmdir "/home/$USERNAME/.config/systemd/user/default.target.wants" 2>/dev/null || true

chown -R "$USERNAME:$USERNAME" "/home/$USERNAME"
chmod 0700 "/home/$USERNAME"
CHROOT

printf '\nSet the password for %s.\n' "$USERNAME"
arch-chroot /mnt passwd "$USERNAME"

printf '\nRunning installation checks...\n'
[ -f /mnt/etc/fstab ] || die 'fstab missing.'
[ -f /mnt/boot/loader/entries/calypso.conf ] || die 'systemd-boot entry missing.'
[ -f /mnt/etc/sddm.conf.d/calypso.conf ] || die 'SDDM configuration missing.'
[ -f "/mnt/home/$USERNAME/.local/share/calypso/calypso-mark.svg" ] || die 'Calypso logo missing.'
[ -f "/mnt/home/$USERNAME/.local/share/calypso/wallpapers/Calypso-Default.svg" ] || die 'Calypso wallpaper missing.'

if [ "$DESKTOP_ID" = kde ]; then
    [ -f "/mnt/home/$USERNAME/.config/autostart/calypso-plasma-wallpaper.desktop" ] || die 'KDE wallpaper autostart missing.'
    [ -f /mnt/usr/share/wayland-sessions/plasma.desktop ] || die 'KDE Plasma Wayland session missing.'
fi
if [ "$DESKTOP_ID" = hyprland ]; then
    [ -f "/mnt/home/$USERNAME/.config/hypr/hyprland.lua" ] || die 'Hyprland configuration missing.'
    [ -f "/mnt/home/$USERNAME/.config/quickshell/aurora/shell.qml" ] || die 'Aurora Quickshell configuration missing.'
    [ -f /mnt/usr/share/wayland-sessions/hyprland.desktop ] || die 'Hyprland Wayland session missing.'
fi

printf '\n$bCALYPSO LINUX READY$b\n' "$CYAN" "$RESET"
printf 'User: $s\nHostname: $s\nDesktop: $s\nBoot: systemd-boot (UEFI)\n' "$USERNAME" "$HOSTNAME" "$DESKTOP_NAME"
printf 'Installation complete. Remove the ISO and reboot.\n'
read -r -p 'Press Enter to reboot, or Ctrl+C to stay in the live session... ' _
reboot
CHROOT
