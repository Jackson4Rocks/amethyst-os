#!/bin/sh

clear
printf "%s\n" "============================================================"
printf "%s\n" "                 AMETHYST OS AURORA"
printf "%s\n" "                      INSTALLER"
printf "%s\n" "============================================================"
printf "\n"
printf "%s\n" "Welcome to Amethyst OS."
printf "%s\n" "The guided Arch installer will now start."
printf "\n"
printf "%s" "Launch installer? [Y/n]: "
read -r answer

case "$answer" in
    n|N)
        printf "%s\n" "Installer cancelled."
        exit 0
        ;;
esac

printf "%s\n" "Launching archinstall..."
sleep 1

exec sudo archinstall
