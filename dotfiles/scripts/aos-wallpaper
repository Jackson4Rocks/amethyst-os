#!/bin/bash
set -euo pipefail

WALL="${1:-}"

if [[ -z "$WALL" ]]; then
  WALL="$(find "$HOME/Pictures/wallpapers" -type f \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' \) 2>/dev/null | fuzzel --dmenu --prompt='Wallpaper > ' | head -n1 || true)"
fi

if [[ -z "$WALL" ]]; then
  echo "No wallpaper selected."
  exit 0
fi

if [[ ! -f "$WALL" ]]; then
  echo "Wallpaper not found: $WALL" >&2
  exit 1
fi

mkdir -p "$HOME/.config/amethyst" "$HOME/.config/kitty"

if command -v matugen >/dev/null 2>&1; then
  matugen image "$WALL" -m dark
fi

if command -v hyprctl >/dev/null 2>&1; then
  while IFS= read -r monitor; do
    [[ -n "$monitor" ]] || continue
    hyprctl hyprpaper wallpaper "$monitor,$WALL,cover" >/dev/null 2>&1 || true
  done < <(hyprctl monitors -j 2>/dev/null | jq -r '.[].name' 2>/dev/null || true)
fi

printf 'AURORA wallpaper set: %s\n' "$WALL"
